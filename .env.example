# ==============================================================================
# ARTS APPAREL — Environment Configuration Template
# ==============================================================================
# RUNTIME ARCHITECTURE:
# The application runs on Cloudflare Workers using @cloudflare/vite-plugin
# with Workers Static Assets and native Cloudflare Workers AI (env.AI).
# Primary Model: @cf/zai-org/glm-4.7-flash (Fallback: @cf/meta/llama-3.3-70b-instruct-fp8-fast)
# ==============================================================================

# Supabase Frontend Credentials (Public / Build-time variables for client bundle)
# Exposed to client browser; never place service-role key here!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SITE_URL="https://artsapparel.pk"
VITE_GOOGLE_AUTH_ENABLED="false"

# Explicit Demo Mode toggle ("true" for mock preview testing, "false" for production)
VITE_DEMO_MODE="false"

# Supabase Server-Side Runtime Credentials
# SUPABASE_URL: Worker runtime variable configured in wrangler.jsonc [vars]
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Worker runtime SECRET only. Set via Cloudflare Dashboard
# or `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
# CRITICAL: Never expose to frontend, never prefix with VITE_, never commit in source control!
SUPABASE_SERVICE_ROLE_KEY=""
