# ==============================================================================
# ARTS APPAREL — Environment Configuration Template
# ==============================================================================
# DEPLOYMENT RUNTIME ARCHITECTURE:
# The current application runs on a Node.js 18+ runtime using Express ('server.ts').
# In development, Express runs with Vite middleware ('npm run dev').
# In production, Express serves the prebuilt Vite SPA bundle ('dist') and handles
# server-side API proxy routes at '/api/ai/*' ('node server.ts').
# NOTE: Deploying directly to Cloudflare Pages requires either hosting the Express
# server on a Node.js container (e.g. Cloud Run / VPS) or implementing a dedicated
# Cloudflare Workers Functions adapter for the '/api/*' endpoints.
# ==============================================================================

# GEMINI_API_KEY: Server-side API key for Google Gemini model requests. Kept server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Frontend Credentials (Vite client bundle)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SITE_URL=""
VITE_GOOGLE_AUTH_ENABLED="false"

# Explicit Demo Mode toggle ("true" for mock preview testing, "false" for production)
# In production, if Supabase credentials are missing and VITE_DEMO_MODE is not "true",
# the app fails closed with a clear configuration banner.
VITE_DEMO_MODE="false"

# Supabase Server-Side Credentials (for server.ts token verification and admin operations)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
