# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Frontend Credentials (Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SITE_URL=""
VITE_GOOGLE_AUTH_ENABLED="false"

# Explicit Demo Mode toggle ("true" for mock testing, "false" for production/real Supabase)
VITE_DEMO_MODE="false"

# Supabase Server-Side Credentials (for server.ts token verification and admin operations)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
